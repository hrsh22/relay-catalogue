# Optional manual Bee launcher. Existing node data and password stay with its operator.
RELAY_BEE_BINARY=/absolute/path/to/bee
RELAY_BEE_DATA=/absolute/path/to/bee-data
RELAY_BEE_PASSWORD_FILE=/absolute/path/to/bee-password-file
RELAY_BEE_RPC_URL=https://xdai.fairdatasociety.org
# No secret is needed for the public reader. Use ignored .runtime/private files for local keys.
