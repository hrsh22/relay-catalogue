{
  "name": "relay-catalogue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3002",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start --hostname 127.0.0.1 --port 3002",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "contract:build": "node scripts/compile-contract.mjs",
    "relay": "tsx scripts/relay.ts",
    "operator:start": "tsx scripts/operator.ts",
    "council:start": "tsx scripts/operator.ts --council",
    "verify:live": "tsx scripts/verify-live.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "format": "prettier --write src scripts tests docs README.md",
    "verify:contract": "node scripts/verify-contract.mjs",
    "verify:fork": "node scripts/verify-fork.mjs"
  },
  "dependencies": {
    "@ethersphere/bee-js": "13.1.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@radix-ui/react-slot": "1.3.3",
    "@safe-global/protocol-kit": "8.0.7",
    "@safe-global/types-kit": "4.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "viem": "2.56.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.8",
    "solc": "0.8.37",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  }
}
